DATABASE_URL="file:./prisma/dev.db"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Export adapter: "file" writes JSON/MD to EXPORT_DIR, "http" POSTs to EXPORT_TARGET_URL
EXPORT_MODE="file"
EXPORT_DIR="./exports"

